# Database Configuration
DB_URL=xyour_secret_here
DB_USERNAME=your_secret_here
DB_PASSWORD=your_secret_here

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_secret_here
GOOGLE_CLIENT_SECRET=your_secret_here

# Mail Configuration (Gmail SMTP)
MAIL_USERNAME=xxx@gmail.com
MAIL_PASSWORD=xxx

# JWT Secret (replace with at least 32 random UTF-8 bytes; never reuse this example)
JWT_SECRET=replace_with_your_own_random_secret_of_at_least_32_bytes

# Dynamic QR Secret (must be different from JWT_SECRET and at least 32 random bytes)
QR_SECRET=replace_with_a_different_random_secret_of_at_least_32_bytes
